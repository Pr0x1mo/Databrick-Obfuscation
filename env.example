# .env.example
# Copy this to .env for local development only.
# .env is in .gitignore and must never be committed.
# On Databricks, these are stored in the secrets scope instead.

# Azure SQL connection
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE_SOURCE=FinanceModernization
SQL_DATABASE_TARGET=FinanceModernization_Masked
SQL_USER=your-sql-login
SQL_PASSWORD=your-sql-password

# HMAC key (generate once with PowerShell, see setup_secrets.sh)
SHIELD_PSEUDO_KEY=your64hexkeyhere
